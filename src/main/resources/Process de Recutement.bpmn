<bpmn2:definitions
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:drools="http://www.jboss.org/drools"
    id="Definitions_Recrutement"
    targetNamespace="https://example.com/recrutement">

  <bpmn2:collaboration id="Collaboration_Recrutement">
    <bpmn2:participant
        id="Participant_Recrutement"
        name="Processus de recrutement"
        processRef="Process_Recrutement"/>
  </bpmn2:collaboration>

  <bpmn2:process
      id="Process_Recrutement"
      name="Processus de recrutement"
      isExecutable="true">

    <!-- LANES -->
    <bpmn2:laneSet id="LaneSet_Recrutement">

      <bpmn2:lane id="Lane_Manager" name="Manager">
        <bpmn2:flowNodeRef>StartEvent</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>JustifierBesoin</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>SoumettreDemande</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>DefinirPoste</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>EntretienTechnique</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>GatewayTechnique</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>ValiderCandidat</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>GatewayValidation</bpmn2:flowNodeRef>
      </bpmn2:lane>

      <bpmn2:lane id="Lane_RH" name="RH Talent Acquisition">
        <bpmn2:flowNodeRef>RedigerOffre</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>PublierOffre</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>ExaminerCV</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>GatewayCV</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>PlanifierEntretienRH</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>EntretienRH</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>GatewayEntretienRH</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>PlanifierEntretienManager</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>ConsoliderEvaluations</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>EnvoyerProposition</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>FormalitesEmbauche</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>PreparerArrivee</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>DemanderAccesIT</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>AccueilCollaborateur</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>SuiviUnMois</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>EndEvent</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>EndEvent_CV</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>EndEvent_EntretienRH</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>EndEvent_Technique</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>EndEvent_Validation</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>_366329E5-87D7-4C7C-9EF4-37F932CB1CA2</bpmn2:flowNodeRef>
      </bpmn2:lane>

      <bpmn2:lane id="Lane_Directeur" name="Directeur RH">
        <bpmn2:flowNodeRef>ExaminerDemande</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>GatewayBesoin</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>EndEvent_Besoin</bpmn2:flowNodeRef>
      </bpmn2:lane>

      <bpmn2:lane id="Lane_Candidat" name="Candidat">
        <bpmn2:flowNodeRef>ConsulterOffres</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>SoumettreCandidature</bpmn2:flowNodeRef>
      </bpmn2:lane>

      <bpmn2:lane id="Lane_IT" name="IT">
        <bpmn2:flowNodeRef>CreerAccesIT</bpmn2:flowNodeRef>
      </bpmn2:lane>

    </bpmn2:laneSet>

    <!-- EVENTS -->
    <bpmn2:startEvent id="StartEvent"
        name="Besoin de recrutement identifié"/>

    <bpmn2:endEvent id="EndEvent"
        name="Recrutement terminé"/>

    <bpmn2:endEvent id="EndEvent_Besoin"
        name="Besoin refusé"/>

    <bpmn2:endEvent id="EndEvent_CV"
        name="Candidature non retenue"/>

    <bpmn2:endEvent id="EndEvent_EntretienRH"
        name="Entretien RH défavorable"/>

    <bpmn2:endEvent id="EndEvent_Technique"
        name="Entretien technique non validé"/>

    <bpmn2:endEvent id="EndEvent_Validation"
        name="Candidat non validé"/>

    <!-- MANAGER TASKS -->
    <bpmn2:userTask id="JustifierBesoin"
        name="Identifier et justifier le besoin de recrutement"/>

    <bpmn2:userTask id="SoumettreDemande"
        name="Soumettre le besoin de recrutement à la Direction"/>

    <bpmn2:userTask id="DefinirPoste"
        name="Définir la fiche poste"/>

    <bpmn2:userTask id="EntretienTechnique"
        name="Évaluer les compétences techniques et métier"/>

    <bpmn2:userTask id="ValiderCandidat"
        name="Valider le candidat retenu"/>

    <!-- DIRECTEUR RH TASK -->
    <bpmn2:userTask id="ExaminerDemande"
        name="Examiner le besoin de recrutement"/>

    <!-- RH TASKS -->
    <bpmn2:userTask id="RedigerOffre"
        name="Rédiger l'offre d'emploi"/>

    <bpmn2:userTask id="PublierOffre"
        name="Publier l'offre d'emploi"/>

    <bpmn2:userTask id="ExaminerCV"
        name="Examiner les candidatures et les CV"/>

    <bpmn2:userTask id="PlanifierEntretienRH"
        name="Planifier l'entretien téléphonique"/>

    <bpmn2:userTask id="EntretienRH"
        name="Mener l'entretien RH et saisir l'évaluation"/>

    <bpmn2:userTask id="PlanifierEntretienManager"
        name="Planifier l'entretien avec le Manager"/>

    <bpmn2:userTask id="ConsoliderEvaluations"
        name="Consolider les évaluations des candidats"/>

    <bpmn2:userTask id="EnvoyerProposition"
        name="Générer et envoyer la proposition d'embauche"/>

    <bpmn2:userTask id="FormalitesEmbauche"
        name="Préparer le contrat, le registre du personnel, la visite médicale et la CNSS"/>

    <bpmn2:userTask id="PreparerArrivee"
        name="Préparer le dossier d'arrivée, le livret et le planning"/>

    <bpmn2:userTask id="DemanderAccesIT"
        name="Demander les accès et le matériel à l'IT"/>

    <bpmn2:userTask id="AccueilCollaborateur"
        name="Accueillir le collaborateur et remettre les documents et accès"/>

    <bpmn2:userTask id="SuiviUnMois"
        name="Organiser le suivi d'intégration à un mois"/>

    <!-- CANDIDATE TASKS -->
    <bpmn2:userTask id="ConsulterOffres"
        name="Consulter les offres publiées"/>

    <bpmn2:userTask id="SoumettreCandidature"
        name="Soumettre la candidature et le CV"/>

    <!-- IT TASK -->
    <bpmn2:userTask id="CreerAccesIT"
        name="Créer les comptes et préparer le matériel"/>

    <!-- GATEWAYS -->
    <bpmn2:exclusiveGateway id="GatewayBesoin"
        name="Besoin accepté ?"
        gatewayDirection="Diverging"
        default="Flow_04_NON"/>

    <bpmn2:exclusiveGateway id="GatewayCV"
        name="CV retenu ?"
        gatewayDirection="Diverging"
        default="Flow_10_NON"/>

    <bpmn2:exclusiveGateway id="GatewayEntretienRH"
        name="Entretien RH favorable ?"
        gatewayDirection="Diverging"
        default="Flow_12_NON"/>

    <bpmn2:exclusiveGateway id="GatewayTechnique"
        name="Entretien technique validé ?"
        gatewayDirection="Diverging"
        default="Flow_14_NON"/>

    <bpmn2:exclusiveGateway id="GatewayValidation"
        name="Candidat validé ?"
        gatewayDirection="Diverging"
        default="Flow_16_NON"/>

    <!-- SEQUENCE FLOWS -->
    <bpmn2:sequenceFlow id="Flow_01"
        sourceRef="StartEvent" targetRef="JustifierBesoin"/>

    <bpmn2:sequenceFlow id="Flow_02"
        sourceRef="JustifierBesoin" targetRef="SoumettreDemande"/>

    <bpmn2:sequenceFlow id="Flow_03"
        sourceRef="SoumettreDemande" targetRef="ExaminerDemande"/>

    <!-- GATEWAY 1 -->
    <bpmn2:sequenceFlow id="Flow_04"
        sourceRef="ExaminerDemande" targetRef="GatewayBesoin"/>

    <bpmn2:sequenceFlow id="Flow_04_OUI"
        name="Oui"
        sourceRef="GatewayBesoin"
        targetRef="DefinirPoste">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression">${besoinAccepte == true}</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>

    <bpmn2:sequenceFlow id="Flow_04_NON"
        name="Non"
        sourceRef="GatewayBesoin"
        targetRef="EndEvent_Besoin"/>

    <!-- CONTINUATION -->
    <bpmn2:sequenceFlow id="Flow_05"
        sourceRef="DefinirPoste" targetRef="RedigerOffre"/>

    <bpmn2:sequenceFlow id="Flow_06"
        sourceRef="RedigerOffre" targetRef="PublierOffre"/>

    <bpmn2:sequenceFlow id="Flow_07"
        sourceRef="PublierOffre" targetRef="ConsulterOffres"/>

    <bpmn2:sequenceFlow id="Flow_08"
        sourceRef="ConsulterOffres" targetRef="SoumettreCandidature"/>

    <bpmn2:sequenceFlow id="Flow_09"
        sourceRef="SoumettreCandidature" targetRef="ExaminerCV"/>

    <!-- GATEWAY 2 -->
    <bpmn2:sequenceFlow id="Flow_10"
        sourceRef="ExaminerCV" targetRef="GatewayCV"/>

    <bpmn2:sequenceFlow id="Flow_10_OUI"
        name="Oui"
        sourceRef="GatewayCV"
        targetRef="PlanifierEntretienRH">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression">${cvRetenu == true}</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>

    <bpmn2:sequenceFlow id="Flow_10_NON"
        name="Non"
        sourceRef="GatewayCV"
        targetRef="EndEvent_CV"/>

    <!-- GATEWAY 3 -->
    <bpmn2:sequenceFlow id="Flow_11"
        sourceRef="PlanifierEntretienRH" targetRef="EntretienRH"/>

    <bpmn2:sequenceFlow id="Flow_12"
        sourceRef="EntretienRH" targetRef="GatewayEntretienRH"/>

    <bpmn2:sequenceFlow id="Flow_12_OUI"
        name="Favorable"
        sourceRef="GatewayEntretienRH"
        targetRef="PlanifierEntretienManager">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression">${entretienRHValide == true}</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>

    <bpmn2:sequenceFlow id="Flow_12_NON"
        name="Défavorable"
        sourceRef="GatewayEntretienRH"
        targetRef="EndEvent_EntretienRH"/>

    <!-- GATEWAY 4 -->
    <bpmn2:sequenceFlow id="Flow_13"
        sourceRef="PlanifierEntretienManager" targetRef="EntretienTechnique"/>

    <bpmn2:sequenceFlow id="Flow_14"
        sourceRef="EntretienTechnique" targetRef="GatewayTechnique"/>

    <bpmn2:sequenceFlow id="Flow_14_OUI"
        name="Validé"
        sourceRef="GatewayTechnique"
        targetRef="ConsoliderEvaluations">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression">${entretienTechniqueValide == true}</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>

    <bpmn2:sequenceFlow id="Flow_14_NON"
        name="Non validé"
        sourceRef="GatewayTechnique"
        targetRef="EndEvent_Technique"/>

    <!-- GATEWAY 5 -->
    <bpmn2:sequenceFlow id="Flow_15"
        sourceRef="ConsoliderEvaluations" targetRef="ValiderCandidat"/>

    <bpmn2:sequenceFlow id="Flow_16"
        sourceRef="ValiderCandidat" targetRef="GatewayValidation"/>

    <bpmn2:sequenceFlow id="Flow_16_OUI"
        name="Oui"
        sourceRef="GatewayValidation"
        targetRef="EnvoyerProposition">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression">${candidatValide == true}</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>

    <bpmn2:sequenceFlow id="Flow_16_NON"
        name="Non"
        sourceRef="GatewayValidation"
        targetRef="EndEvent_Validation"/>

    <!-- FINAL RECRUITMENT STEPS -->
    <bpmn2:sequenceFlow id="Flow_17"
        sourceRef="EnvoyerProposition" targetRef="FormalitesEmbauche"/>

    <bpmn2:sequenceFlow id="Flow_18"
        sourceRef="FormalitesEmbauche" targetRef="PreparerArrivee"/>

    <bpmn2:sequenceFlow id="Flow_19"
        sourceRef="PreparerArrivee" targetRef="DemanderAccesIT"/>

    <bpmn2:sequenceFlow id="Flow_20"
        sourceRef="DemanderAccesIT" targetRef="CreerAccesIT"/>

    <bpmn2:sequenceFlow id="Flow_21"
        sourceRef="CreerAccesIT" targetRef="AccueilCollaborateur"/>

    <bpmn2:sequenceFlow id="Flow_22"
        sourceRef="AccueilCollaborateur" targetRef="SuiviUnMois"/>

    <bpmn2:sequenceFlow id="Flow_23"
        sourceRef="SuiviUnMois" targetRef="EndEvent"/>

    <!-- ANNOTATIONS -->
    <bpmn2:association
        id="_929943FA-82E2-460C-9A61-3ED1C01FD20B"
        associationDirection="Both"
        sourceRef="DefinirPoste"
        targetRef="_4CB6FE5A-C3CA-48C8-A722-1280E9940087"/>

    <bpmn2:association
        id="_CE311052-0FC3-4779-86B3-24E214872DC5"
        associationDirection="Both"
        sourceRef="PublierOffre"
        targetRef="_366329E5-87D7-4C7C-9EF4-37F932CB1CA2"/>

    <bpmn2:textAnnotation id="_4CB6FE5A-C3CA-48C8-A722-1280E9940087">
      <bpmn2:text>définir les missions, les compétences et l'expérience</bpmn2:text>
    </bpmn2:textAnnotation>

    <bpmn2:textAnnotation id="_366329E5-87D7-4C7C-9EF4-37F932CB1CA2">
      <bpmn2:text>ou la publier</bpmn2:text>
    </bpmn2:textAnnotation>

  </bpmn2:process>

  <!-- BPMN DIAGRAM -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_Recrutement">
    <bpmndi:BPMNPlane
        id="BPMNPlane_Recrutement"
        bpmnElement="Collaboration_Recrutement">

      <!-- PARTICIPANT -->
      <bpmndi:BPMNShape id="Participant_Recrutement_di"
          bpmnElement="Participant_Recrutement"
          isHorizontal="true">
        <dc:Bounds x="120" y="40" width="5200" height="790"/>
      </bpmndi:BPMNShape>

      <!-- LANES -->
      <bpmndi:BPMNShape id="Lane_Manager_di" bpmnElement="Lane_Manager" isHorizontal="true">
        <dc:Bounds x="120" y="40" width="5200" height="150"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Lane_RH_di" bpmnElement="Lane_RH" isHorizontal="true">
        <dc:Bounds x="120" y="190" width="5200" height="150"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Lane_Directeur_di" bpmnElement="Lane_Directeur" isHorizontal="true">
        <dc:Bounds x="120" y="360" width="5200" height="150"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Lane_Candidat_di" bpmnElement="Lane_Candidat" isHorizontal="true">
        <dc:Bounds x="120" y="520" width="5200" height="150"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Lane_IT_di" bpmnElement="Lane_IT" isHorizontal="true">
        <dc:Bounds x="120" y="680" width="5200" height="150"/>
      </bpmndi:BPMNShape>

      <!-- START AND END EVENTS -->
      <bpmndi:BPMNShape id="StartEvent_di" bpmnElement="StartEvent">
        <dc:Bounds x="200" y="97" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_di" bpmnElement="EndEvent">
        <dc:Bounds x="4800" y="247" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_Besoin_di" bpmnElement="EndEvent_Besoin">
        <dc:Bounds x="920" y="417" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_CV_di" bpmnElement="EndEvent_CV">
        <dc:Bounds x="2240" y="295" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_EntretienRH_di" bpmnElement="EndEvent_EntretienRH">
        <dc:Bounds x="2610" y="295" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_Technique_di" bpmnElement="EndEvent_Technique">
        <dc:Bounds x="2980" y="145" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_Validation_di" bpmnElement="EndEvent_Validation">
        <dc:Bounds x="3400" y="145" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <!-- MANAGER TASKS -->
      <bpmndi:BPMNShape id="JustifierBesoin_di" bpmnElement="JustifierBesoin">
        <dc:Bounds x="280" y="80" width="150" height="70"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="SoumettreDemande_di" bpmnElement="SoumettreDemande">
        <dc:Bounds x="480" y="80" width="150" height="70"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="DefinirPoste_di" bpmnElement="DefinirPoste">
        <dc:Bounds x="920" y="80" width="150" height="70"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EntretienTechnique_di" bpmnElement="EntretienTechnique">
        <dc:Bounds x="2760" y="80" width="150" height="70"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="ValiderCandidat_di" bpmnElement="ValiderCandidat">
        <dc:Bounds x="3180" y="80" width="150" height="70"/>
      </bpmndi:BPMNShape>

      <!-- DIRECTEUR RH -->
      <bpmndi:BPMNShape id="ExaminerDemande_di" bpmnElement="ExaminerDemande">
        <dc:Bounds x="680" y="400" width="150" height="70"/>
      </bpmndi:BPMNShape>

      <!-- RH TASKS -->
      <bpmndi:BPMNShape id="RedigerOffre_di" bpmnElement="RedigerOffre">
        <dc:Bounds x="1120" y="230" width="150" height="70"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="PublierOffre_di" bpmnElement="PublierOffre">
        <dc:Bounds x="1320" y="230" width="150" height="70"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="ExaminerCV_di" bpmnElement="ExaminerCV">
        <dc:Bounds x="1920" y="230" width="150" height="70"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="PlanifierEntretienRH_di" bpmnElement="PlanifierEntretienRH">
        <dc:Bounds x="2140" y="230" width="150" height="70"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EntretienRH_di" bpmnElement="EntretienRH">
        <dc:Bounds x="2340" y="230" width="150" height="70"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="PlanifierEntretienManager_di" bpmnElement="PlanifierEntretienManager">
        <dc:Bounds x="2560" y="230" width="150" height="70"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="ConsoliderEvaluations_di" bpmnElement="ConsoliderEvaluations">
        <dc:Bounds x="2980" y="230" width="150" height="70"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EnvoyerProposition_di" bpmnElement="EnvoyerProposition">
        <dc:Bounds x="3400" y="230" width="150" height="70"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="FormalitesEmbauche_di" bpmnElement="FormalitesEmbauche">
        <dc:Bounds x="3600" y="220" width="160" height="120"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="PreparerArrivee_di" bpmnElement="PreparerArrivee">
        <dc:Bounds x="3800" y="230" width="150" height="70"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="DemanderAccesIT_di" bpmnElement="DemanderAccesIT">
        <dc:Bounds x="4000" y="230" width="150" height="70"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="AccueilCollaborateur_di" bpmnElement="AccueilCollaborateur">
        <dc:Bounds x="4400" y="220" width="160" height="120"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="SuiviUnMois_di" bpmnElement="SuiviUnMois">
        <dc:Bounds x="4600" y="230" width="150" height="70"/>
      </bpmndi:BPMNShape>

      <!-- CANDIDATE TASKS -->
      <bpmndi:BPMNShape id="ConsulterOffres_di" bpmnElement="ConsulterOffres">
        <dc:Bounds x="1520" y="560" width="150" height="70"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="SoumettreCandidature_di" bpmnElement="SoumettreCandidature">
        <dc:Bounds x="1720" y="560" width="150" height="70"/>
      </bpmndi:BPMNShape>

      <!-- IT TASK -->
      <bpmndi:BPMNShape id="CreerAccesIT_di" bpmnElement="CreerAccesIT">
        <dc:Bounds x="4200" y="720" width="150" height="70"/>
      </bpmndi:BPMNShape>

      <!-- GATEWAYS -->
      <bpmndi:BPMNShape id="GatewayBesoin_di" bpmnElement="GatewayBesoin" isMarkerVisible="true">
        <dc:Bounds x="840" y="415" width="40" height="40"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="GatewayCV_di" bpmnElement="GatewayCV" isMarkerVisible="true">
        <dc:Bounds x="2075" y="245" width="40" height="40"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="GatewayEntretienRH_di" bpmnElement="GatewayEntretienRH" isMarkerVisible="true">
        <dc:Bounds x="2495" y="245" width="40" height="40"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="GatewayTechnique_di" bpmnElement="GatewayTechnique" isMarkerVisible="true">
        <dc:Bounds x="2915" y="95" width="40" height="40"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="GatewayValidation_di" bpmnElement="GatewayValidation" isMarkerVisible="true">
        <dc:Bounds x="3335" y="95" width="40" height="40"/>
      </bpmndi:BPMNShape>

      <!-- ANNOTATIONS -->
      <bpmndi:BPMNShape id="_676DD3D9-973D-455B-8689-34489E070537"
          bpmnElement="_4CB6FE5A-C3CA-48C8-A722-1280E9940087">
        <dc:Bounds x="1080" y="60" width="200" height="100"/>
