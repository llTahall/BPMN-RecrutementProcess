<?xml version="1.0" encoding="UTF-8" ?>
<bpmn2:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:drools="http://www.jboss.org/drools" id="Definitions_Recrutement" targetNamespace="https://example.com/recrutement">
  <bpmn2:itemDefinition id="BooleanType" structureRef="xsd:boolean" />
  <bpmn2:itemDefinition id="_9C9E2C04-23F0-4FD8-A05C-2D8DD7FD8775" structureRef="Boolean" />
  <bpmn2:correlationProperty id="_D283411A-A2CA-43A1-93C9-4C82CD16FA62" name="New Property">
  </bpmn2:correlationProperty>
  <bpmn2:collaboration id="Collaboration_Recrutement">
    <bpmn2:participant id="Participant_Recrutement" name="Processus de recrutement" processRef="Process_Recrutement" />
  </bpmn2:collaboration>
  <bpmn2:process id="Process_Recrutement" name="Processus de recrutement" isExecutable="true">
    <bpmn2:property id="var_besoinAccepte" name="besoinAccepte" itemSubjectRef="_9C9E2C04-23F0-4FD8-A05C-2D8DD7FD8775" />
    <bpmn2:property id="var_cvRetenu" name="cvRetenu" itemSubjectRef="_9C9E2C04-23F0-4FD8-A05C-2D8DD7FD8775" />
    <bpmn2:property id="var_entretienRHValide" name="entretienRHValide" itemSubjectRef="_9C9E2C04-23F0-4FD8-A05C-2D8DD7FD8775" />
    <bpmn2:property id="var_entretienTechniqueValide" name="entretienTechniqueValide" itemSubjectRef="_9C9E2C04-23F0-4FD8-A05C-2D8DD7FD8775" />
    <bpmn2:property id="var_candidatValide" name="candidatValide" itemSubjectRef="_9C9E2C04-23F0-4FD8-A05C-2D8DD7FD8775" />
    <bpmn2:laneSet id="LaneSet_Recrutement">
      <bpmn2:lane id="Lane_Manager" name="Manager">
        <bpmn2:flowNodeRef>StartEvent</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>JustifierBesoin</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>SoumettreDemande</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>DefinirPoste</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>EntretienTechnique</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>GatewayTechnique</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>EndEvent_Technique</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>ValiderCandidat</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>GatewayValidation</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>EndEvent_Validation</bpmn2:flowNodeRef>
      </bpmn2:lane>
      <bpmn2:lane id="Lane_RH" name="RH Talent Acquisition">
        <bpmn2:flowNodeRef>RedigerOffre</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>PublierOffre</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>ExaminerCV</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>GatewayCV</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>EndEvent_CV</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>PlanifierEntretienRH</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>EntretienRH</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>GatewayEntretienRH</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>EndEvent_EntretienRH</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>PlanifierEntretienManager</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>ConsoliderEvaluations</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>EnvoyerProposition</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>FormalitesEmbauche</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>PreparerArrivee</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>DemanderAccesIT</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>AccueilCollaborateur</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>SuiviUnMois</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>EndEvent</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Annotation_PublierOffre</bpmn2:flowNodeRef>
      </bpmn2:lane>
      <bpmn2:lane id="Lane_Directeur" name="Directeur RH">
        <bpmn2:flowNodeRef>ExaminerDemande</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>GatewayBesoin</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>EndEvent_Besoin</bpmn2:flowNodeRef>
      </bpmn2:lane>
      <bpmn2:lane id="Lane_Candidat" name="Candidat">
        <bpmn2:flowNodeRef>ConsulterOffres</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>SoumettreCandidature</bpmn2:flowNodeRef>
      </bpmn2:lane>
      <bpmn2:lane id="Lane_IT" name="IT">
        <bpmn2:flowNodeRef>CreerAccesIT</bpmn2:flowNodeRef>
      </bpmn2:lane>
    </bpmn2:laneSet>
    <bpmn2:startEvent id="StartEvent" name="Besoin de recrutement identifié">
      <bpmn2:outgoing>Flow_01</bpmn2:outgoing>
    </bpmn2:startEvent>
    <bpmn2:endEvent id="EndEvent" name="Recrutement terminé">
      <bpmn2:incoming>Flow_23</bpmn2:incoming>
    </bpmn2:endEvent>
    <bpmn2:endEvent id="EndEvent_Besoin" name="Besoin refusé">
      <bpmn2:incoming>Flow_04_NON</bpmn2:incoming>
    </bpmn2:endEvent>
    <bpmn2:endEvent id="EndEvent_CV" name="Candidature non retenue">
      <bpmn2:incoming>Flow_10_NON</bpmn2:incoming>
    </bpmn2:endEvent>
    <bpmn2:endEvent id="EndEvent_EntretienRH" name="Entretien RH défavorable">
      <bpmn2:incoming>Flow_12_NON</bpmn2:incoming>
    </bpmn2:endEvent>
    <bpmn2:endEvent id="EndEvent_Technique" name="Entretien technique non validé">
      <bpmn2:incoming>Flow_14_NON</bpmn2:incoming>
    </bpmn2:endEvent>
    <bpmn2:endEvent id="EndEvent_Validation" name="Candidat non validé">
      <bpmn2:incoming>Flow_16_NON</bpmn2:incoming>
    </bpmn2:endEvent>
    <bpmn2:exclusiveGateway id="GatewayBesoin" name="Besoin accepté ?" gatewayDirection="Diverging" default="Flow_04_NON">
      <bpmn2:incoming>Flow_04</bpmn2:incoming>
      <bpmn2:outgoing>Flow_04_OUI</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_04_NON</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:exclusiveGateway id="GatewayCV" name="CV retenu ?" gatewayDirection="Diverging" default="Flow_10_NON">
      <bpmn2:incoming>Flow_10</bpmn2:incoming>
      <bpmn2:outgoing>Flow_10_OUI</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_10_NON</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:exclusiveGateway id="GatewayEntretienRH" name="Entretien RH favorable ?" gatewayDirection="Diverging" default="Flow_12_NON">
      <bpmn2:incoming>Flow_12</bpmn2:incoming>
      <bpmn2:outgoing>Flow_12_OUI</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_12_NON</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:exclusiveGateway id="GatewayTechnique" name="Entretien technique validé ?" gatewayDirection="Diverging" default="Flow_14_NON">
      <bpmn2:incoming>Flow_14</bpmn2:incoming>
      <bpmn2:outgoing>Flow_14_OUI</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_14_NON</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:exclusiveGateway id="GatewayValidation" name="Candidat validé ?" gatewayDirection="Diverging" default="Flow_16_NON">
      <bpmn2:incoming>Flow_16</bpmn2:incoming>
      <bpmn2:outgoing>Flow_16_OUI</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_16_NON</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:userTask id="JustifierBesoin" name="Identifier et justifier le besoin de recrutement">
      <bpmn2:incoming>Flow_01</bpmn2:incoming>
      <bpmn2:outgoing>Flow_02</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:userTask id="SoumettreDemande" name="Soumettre le besoin de recrutement à la Direction">
      <bpmn2:incoming>Flow_02</bpmn2:incoming>
      <bpmn2:outgoing>Flow_03</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:userTask id="DefinirPoste" name="Définir la fiche poste">
      <bpmn2:incoming>Flow_04_OUI</bpmn2:incoming>
      <bpmn2:outgoing>Flow_05</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:userTask id="EntretienTechnique" name="Évaluer les compétences techniques et métier">
      <bpmn2:incoming>Flow_13</bpmn2:incoming>
      <bpmn2:outgoing>Flow_14</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:userTask id="ValiderCandidat" name="Valider le candidat retenu">
      <bpmn2:incoming>Flow_15</bpmn2:incoming>
      <bpmn2:outgoing>Flow_16</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:userTask id="ExaminerDemande" name="Examiner le besoin de recrutement">
      <bpmn2:incoming>Flow_03</bpmn2:incoming>
      <bpmn2:outgoing>Flow_04</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:userTask id="RedigerOffre" name="Rédiger l&apos;offre d&apos;emploi">
      <bpmn2:incoming>Flow_05</bpmn2:incoming>
      <bpmn2:outgoing>Flow_06</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:userTask id="PublierOffre" name="Publier l&apos;offre d&apos;emploi">
      <bpmn2:incoming>Flow_06</bpmn2:incoming>
      <bpmn2:outgoing>Flow_07</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:userTask id="ExaminerCV" name="Examiner les candidatures et les CV">
      <bpmn2:incoming>Flow_09</bpmn2:incoming>
      <bpmn2:outgoing>Flow_10</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:userTask id="PlanifierEntretienRH" name="Planifier l&apos;entretien téléphonique">
      <bpmn2:incoming>Flow_10_OUI</bpmn2:incoming>
      <bpmn2:outgoing>Flow_11</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:userTask id="EntretienRH" name="Mener l&apos;entretien RH et saisir l&apos;évaluation">
      <bpmn2:incoming>Flow_11</bpmn2:incoming>
      <bpmn2:outgoing>Flow_12</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:userTask id="PlanifierEntretienManager" name="Planifier l&apos;entretien avec le Manager">
      <bpmn2:incoming>Flow_12_OUI</bpmn2:incoming>
      <bpmn2:outgoing>Flow_13</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:userTask id="ConsoliderEvaluations" name="Consolider les évaluations des candidats">
      <bpmn2:incoming>Flow_14_OUI</bpmn2:incoming>
      <bpmn2:outgoing>Flow_15</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:userTask id="EnvoyerProposition" name="Générer et envoyer la proposition d&apos;embauche">
      <bpmn2:incoming>Flow_16_OUI</bpmn2:incoming>
      <bpmn2:outgoing>Flow_17</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:userTask id="FormalitesEmbauche" name="Préparer le contrat, le registre du personnel, la visite médicale et la CNSS">
      <bpmn2:incoming>Flow_17</bpmn2:incoming>
      <bpmn2:outgoing>Flow_18</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:userTask id="PreparerArrivee" name="Préparer le dossier d&apos;arrivée, le livret et le planning">
      <bpmn2:incoming>Flow_18</bpmn2:incoming>
      <bpmn2:outgoing>Flow_19</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:userTask id="DemanderAccesIT" name="Demander les accès et le matériel à l&apos;IT">
      <bpmn2:incoming>Flow_19</bpmn2:incoming>
      <bpmn2:outgoing>Flow_20</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:userTask id="AccueilCollaborateur" name="Accueillir le collaborateur et remettre les documents et accès">
      <bpmn2:incoming>Flow_21</bpmn2:incoming>
      <bpmn2:outgoing>Flow_22</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:userTask id="SuiviUnMois" name="Organiser le suivi d&apos;intégration à un mois">
      <bpmn2:incoming>Flow_22</bpmn2:incoming>
      <bpmn2:outgoing>Flow_23</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:userTask id="ConsulterOffres" name="Consulter les offres publiées">
      <bpmn2:incoming>Flow_07</bpmn2:incoming>
      <bpmn2:outgoing>Flow_08</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:userTask id="SoumettreCandidature" name="Soumettre la candidature et le CV">
      <bpmn2:incoming>Flow_08</bpmn2:incoming>
      <bpmn2:outgoing>Flow_09</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:userTask id="CreerAccesIT" name="Créer les comptes et préparer le matériel">
      <bpmn2:incoming>Flow_20</bpmn2:incoming>
      <bpmn2:outgoing>Flow_21</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:sequenceFlow id="Flow_01" sourceRef="StartEvent" targetRef="JustifierBesoin" />
    <bpmn2:sequenceFlow id="Flow_02" sourceRef="JustifierBesoin" targetRef="SoumettreDemande" />
    <bpmn2:sequenceFlow id="Flow_03" sourceRef="SoumettreDemande" targetRef="ExaminerDemande" />
    <bpmn2:sequenceFlow id="Flow_04" sourceRef="ExaminerDemande" targetRef="GatewayBesoin" />
    <bpmn2:sequenceFlow id="Flow_04_OUI" name="Oui" sourceRef="GatewayBesoin" targetRef="DefinirPoste">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.mvel.org/2.0">besoinAccepte == true</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_04_NON" name="Non" sourceRef="GatewayBesoin" targetRef="EndEvent_Besoin" />
    <bpmn2:sequenceFlow id="Flow_05" sourceRef="DefinirPoste" targetRef="RedigerOffre" />
    <bpmn2:sequenceFlow id="Flow_06" sourceRef="RedigerOffre" targetRef="PublierOffre" />
    <bpmn2:sequenceFlow id="Flow_07" sourceRef="PublierOffre" targetRef="ConsulterOffres" />
    <bpmn2:sequenceFlow id="Flow_08" sourceRef="ConsulterOffres" targetRef="SoumettreCandidature" />
    <bpmn2:sequenceFlow id="Flow_09" sourceRef="SoumettreCandidature" targetRef="ExaminerCV" />
    <bpmn2:sequenceFlow id="Flow_10" sourceRef="ExaminerCV" targetRef="GatewayCV" />
    <bpmn2:sequenceFlow id="Flow_10_OUI" name="Oui" sourceRef="GatewayCV" targetRef="PlanifierEntretienRH">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.mvel.org/2.0">cvRetenu == true</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_10_NON" name="Non" sourceRef="GatewayCV" targetRef="EndEvent_CV" />
    <bpmn2:sequenceFlow id="Flow_11" sourceRef="PlanifierEntretienRH" targetRef="EntretienRH" />
    <bpmn2:sequenceFlow id="Flow_12" sourceRef="EntretienRH" targetRef="GatewayEntretienRH" />
    <bpmn2:sequenceFlow id="Flow_12_OUI" name="Favorable" sourceRef="GatewayEntretienRH" targetRef="PlanifierEntretienManager">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.mvel.org/2.0">entretienRHValide == true</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_12_NON" name="Défavorable" sourceRef="GatewayEntretienRH" targetRef="EndEvent_EntretienRH" />
    <bpmn2:sequenceFlow id="Flow_13" sourceRef="PlanifierEntretienManager" targetRef="EntretienTechnique" />
    <bpmn2:sequenceFlow id="Flow_14" sourceRef="EntretienTechnique" targetRef="GatewayTechnique" />
    <bpmn2:sequenceFlow id="Flow_14_OUI" name="Validé" sourceRef="GatewayTechnique" targetRef="ConsoliderEvaluations">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.mvel.org/2.0">entretienTechniqueValide == true</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_14_NON" name="Non validé" sourceRef="GatewayTechnique" targetRef="EndEvent_Technique" />
    <bpmn2:sequenceFlow id="Flow_15" sourceRef="ConsoliderEvaluations" targetRef="ValiderCandidat" />
    <bpmn2:sequenceFlow id="Flow_16" sourceRef="ValiderCandidat" targetRef="GatewayValidation" />
    <bpmn2:sequenceFlow id="Flow_16_OUI" name="Oui" sourceRef="GatewayValidation" targetRef="EnvoyerProposition">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.mvel.org/2.0">candidatValide == true</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_16_NON" name="Non" sourceRef="GatewayValidation" targetRef="EndEvent_Validation" />
    <bpmn2:sequenceFlow id="Flow_17" sourceRef="EnvoyerProposition" targetRef="FormalitesEmbauche" />
    <bpmn2:sequenceFlow id="Flow_18" sourceRef="FormalitesEmbauche" targetRef="PreparerArrivee" />
    <bpmn2:sequenceFlow id="Flow_19" sourceRef="PreparerArrivee" targetRef="DemanderAccesIT" />
    <bpmn2:sequenceFlow id="Flow_20" sourceRef="DemanderAccesIT" targetRef="CreerAccesIT" />
    <bpmn2:sequenceFlow id="Flow_21" sourceRef="CreerAccesIT" targetRef="AccueilCollaborateur" />
    <bpmn2:sequenceFlow id="Flow_22" sourceRef="AccueilCollaborateur" targetRef="SuiviUnMois" />
    <bpmn2:sequenceFlow id="Flow_23" sourceRef="SuiviUnMois" targetRef="EndEvent" />
    <bpmn2:association id="Association_DefinirPoste" sourceRef="DefinirPoste" targetRef="Annotation_DefinirPoste" associationDirection="Both" />
    <bpmn2:textAnnotation id="Annotation_DefinirPoste">
      <bpmn2:text>Définir les missions, les compétences et l&apos;expérience</bpmn2:text>
    </bpmn2:textAnnotation>
  </bpmn2:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Recrutement">
    <bpmndi:BPMNPlane id="BPMNPlane_Recrutement" bpmnElement="Collaboration_Recrutement">
      <bpmndi:BPMNShape id="Participant_Recrutement_di" bpmnElement="Participant_Recrutement" isHorizontal="true">
        <dc:Bounds x="100" y="40" width="6400" height="750" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Manager_di" bpmnElement="Lane_Manager" isHorizontal="true">
        <dc:Bounds x="100" y="40" width="6400" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_RH_di" bpmnElement="Lane_RH" isHorizontal="true">
        <dc:Bounds x="100" y="190" width="6400" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Directeur_di" bpmnElement="Lane_Directeur" isHorizontal="true">
        <dc:Bounds x="100" y="340" width="6400" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Candidat_di" bpmnElement="Lane_Candidat" isHorizontal="true">
        <dc:Bounds x="100" y="490" width="6400" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_IT_di" bpmnElement="Lane_IT" isHorizontal="true">
        <dc:Bounds x="100" y="640" width="6400" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_di" bpmnElement="StartEvent">
        <dc:Bounds x="150" y="97" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_di" bpmnElement="EndEvent">
        <dc:Bounds x="6320" y="247" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Besoin_di" bpmnElement="EndEvent_Besoin">
        <dc:Bounds x="1180" y="420" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_CV_di" bpmnElement="EndEvent_CV">
        <dc:Bounds x="2570" y="295" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_EntretienRH_di" bpmnElement="EndEvent_EntretienRH">
        <dc:Bounds x="3220" y="295" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Technique_di" bpmnElement="EndEvent_Technique">
        <dc:Bounds x="3880" y="145" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Validation_di" bpmnElement="EndEvent_Validation">
        <dc:Bounds x="4520" y="145" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="JustifierBesoin_di" bpmnElement="JustifierBesoin">
        <dc:Bounds x="230" y="80" width="150" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SoumettreDemande_di" bpmnElement="SoumettreDemande">
        <dc:Bounds x="440" y="80" width="170" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExaminerDemande_di" bpmnElement="ExaminerDemande">
        <dc:Bounds x="700" y="380" width="180" height="70" />
